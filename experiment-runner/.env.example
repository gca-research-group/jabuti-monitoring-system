# API and experiment
API_BASE_URL=http://localhost:8080
BLOCKCHAIN_ID=d3097aae-298f-46c3-92ea-a01f5ceb714e
SMART_CONTRACT_ID=8e3a7f75-a8b4-4fa4-8fb2-637e6dd953c2
API_KEY=7a13a1bf-1c80-4cf2-8d31-cf9ffcf9959e
DATABASE_URL=postgres://postgres:postgres@200.17.87.134:5432/postgres?sslmode=disable
EXPERIMENT_OUTPUT_DIR=output/experiments

# HTTP connection settings
HTTP_MAX_IDLE_CONNS=3000
HTTP_MAX_IDLE_CONNS_PER_HOST=3000
HTTP_IDLE_CONN_TIMEOUT=90s
HTTP_RESPONSE_HEADER_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=60s

# Hyperledger Fabric server
FABRIC_SERVER_IP=200.17.87.147
FABRIC_SSH_USER=your-fabric-user
FABRIC_SSH_PORT=22
FABRIC_PEER_PORT=7051
FABRIC_CA_CERT_PATH=/home/monitor/app/output/network-with-chaincode/org1.network-with-chaincode.com/data/certificate-authority/organizations/peerOrganizations/org1.network-with-chaincode.com/peers/peer0.org1.network-with-chaincode.com/tls/ca.crt
FABRIC_PRIVATE_KEY_PATH=/home/monitor/app/output/network-with-chaincode/org1.network-with-chaincode.com/data/certificate-authority/organizations/peerOrganizations/org1.network-with-chaincode.com/users/User1@org1.network-with-chaincode.com/msp/keystore/priv_sk
FABRIC_SIGN_CERT_PATH=/home/monitor/app/output/network-with-chaincode/org1.network-with-chaincode.com/data/certificate-authority/organizations/peerOrganizations/org1.network-with-chaincode.com/users/User1@org1.network-with-chaincode.com/msp/signcerts/cert.pem

# RabbitMQ server
RABBITMQ_SERVER_IP=200.17.87.130
RABBITMQ_SSH_USER=your-rabbitmq-user
RABBITMQ_SSH_PORT=22

# PostgreSQL server
POSTGRES_SERVER_IP=200.17.87.134
POSTGRES_SSH_USER=your-postgres-user
POSTGRES_SSH_PORT=22

# API producer server
API_PRODUCER_SSH_SERVER=200.17.87.157
API_PRODUCER_SSH_USER=your-api-producer-user
API_PRODUCER_SSH_PORT=22

# API consumer server
API_CONSUMER_SSH_SERVER=your-api-consumer-server
API_CONSUMER_SSH_USER=your-api-consumer-user
API_CONSUMER_SSH_PORT=22

# Optional container CPU/RAM collection (Linux Docker API >= 1.41 over SSH)
RESOURCE_MONITORING_ENABLED=false
RESOURCE_SAMPLE_INTERVAL=1s
RESOURCE_SAMPLE_TIMEOUT=5s
RESOURCE_PRODUCER_CONTAINER=api-producer
RESOURCE_CONSUMER_CONTAINER=api-consumer
RESOURCE_RABBITMQ_CONTAINER=rabbitmq
RESOURCE_DOCKER_SOCKET=/var/run/docker.sock
